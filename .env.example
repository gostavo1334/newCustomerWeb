# Google Sheets CRUD Application Configuration

# Google Cloud Service Account Credentials
# Download the JSON key file from Google Cloud Console
# and place it in the project root as 'credentials.json'
# OR set the path to your credentials file
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# Google Spreadsheet Configuration
# Get your spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=1J76lBUpfiGwsV9BFqgaKnTNgIzXBS6j3lHaZlKiPquU

# Sheet name (default: Sheet1)
SHEET_NAME=Sheet1

# Server port (default: 3000)
PORT=3000
